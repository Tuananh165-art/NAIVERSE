# Required to enable AI. Store DEEPSEEK_API_KEY in a private local .env
# and in your deployment platform's encrypted environment-variable settings.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Required for sign-in, saved trips and enquiries.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Fallback cho project dùng API key cũ; khóa chỉ publishable mới được để trong NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key chỉ dành cho server: username lookup và seed; không đưa vào client hoặc log.
SUPABASE_SECRET_KEY=
# Fallback cho project dùng khóa cũ; không đặt tiền tố NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Required on public deployments to protect model-cost limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required for live driving directions; the map still works without a key.
OPENROUTESERVICE_API_KEY=

# Public OSM tiles by default; change the provider URL if your project needs it.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_APP_URL=http://localhost:3000
AI_USER_DAILY_LIMIT=20
AI_USER_MINUTE_LIMIT=5
AI_GLOBAL_DAILY_LIMIT=200
DEMO_MODE=true
